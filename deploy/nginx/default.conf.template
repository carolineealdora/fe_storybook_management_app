# Rendered by the official nginx image at start-up: ${BACKEND_ORIGIN} comes from the environment.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Same-origin API: the app calls /api/v1/*, so the browser never needs CORS.
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 60m; # API contract: cover <= 5 MB + EPUB <= 50 MB, request <= 60 MB
        proxy_read_timeout 120s;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Fingerprinted build output never changes: cache for a year.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Single-page app: any other path serves index.html and React Router takes over.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
